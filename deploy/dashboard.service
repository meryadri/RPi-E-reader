# Runs the dashboard on boot.
#
#   sudo cp deploy/dashboard.service /etc/systemd/system/
#   sudo systemctl enable --now dashboard
#
# Edit User= and the paths for your own install.

[Unit]
Description=E-ink dashboard
# The habit web server and the calendar/weather fetches all need the network.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/RPi-E-reader-
ExecStart=/home/pi/RPi-E-reader-/venv/bin/python main.py --app dashboard --backend rpi

# Your location, used by the weather integration.
#Environment=WEATHER_LAT=42.325
#Environment=WEATHER_LON=-71.085

# The Pi has no real-time clock, so on a cold boot the system time is wrong
# until NTP syncs.  A wrong date means the wrong calendar day and the wrong
# habit day, so wait for it rather than racing it.
ExecStartPre=/bin/sh -c 'timeout 60 /usr/bin/timedatectl show -p NTPSynchronized --value | grep -q yes || sleep 20'

Restart=always
RestartSec=10

# Keep the last-good calendar/weather and the habit log across restarts.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
